{
  "$comment": "StudyBond avatar parts, version 1. The one source of truth for the website, the phone app and the server's checks. Copied as-is into studybond-web (scripts/sync-avatar-parts.js) and later the app. Saved avatars store the option ids, never colours, so a colour can change here without touching saved data. Never remove or rename an id; add new ones and bump version only if old saved avatars would draw differently. Drawing: 64x64 viewBox, layers in paint order; a layer shows when every key in `when` lists the avatar's value for that part (a missing key means any value). Colour tokens: @skin, @top, @bg come from the chosen option; @hair, @line come from inks; @glass comes from the skin option.",
  "version": 1,
  "viewBox": "0 0 64 64",
  "parts": ["skin", "hair", "head", "glasses", "top", "bg", "frame"],
  "options": {
    "skin": [
      { "id": "tone1", "label": "Skin tone 1 of 7", "hex": "#3b2219", "glass": "#d8d1c6" },
      { "id": "tone2", "label": "Skin tone 2 of 7", "hex": "#4a2c1e", "glass": "#d8d1c6" },
      { "id": "tone3", "label": "Skin tone 3 of 7", "hex": "#5a3825", "glass": "#17110e" },
      { "id": "tone4", "label": "Skin tone 4 of 7", "hex": "#7a4a2e", "glass": "#17110e" },
      { "id": "tone5", "label": "Skin tone 5 of 7", "hex": "#96613d", "glass": "#17110e" },
      { "id": "tone6", "label": "Skin tone 6 of 7", "hex": "#b07a52", "glass": "#17110e" },
      { "id": "tone7", "label": "Skin tone 7 of 7", "hex": "#c99a72", "glass": "#17110e" }
    ],
    "hair": [
      { "id": "lowcut", "label": "Low cut" },
      { "id": "afro", "label": "Afro" },
      { "id": "braids", "label": "Braids" },
      { "id": "cornrows", "label": "Cornrows" },
      { "id": "bun", "label": "Bun" },
      { "id": "none", "label": "Clean shave" }
    ],
    "head": [
      { "id": "none", "label": "Nothing" },
      { "id": "hijab", "label": "Hijab" },
      { "id": "fila", "label": "Fila" },
      { "id": "facecap", "label": "Face cap" },
      { "id": "gele", "label": "Gele" }
    ],
    "glasses": [
      { "id": "none", "label": "None" },
      { "id": "round", "label": "Round" },
      { "id": "square", "label": "Square" }
    ],
    "top": [
      { "id": "mustard", "label": "Mustard", "hex": "#c9a227" },
      { "id": "green", "label": "Green", "hex": "#2f6f5e" },
      { "id": "maroon", "label": "Maroon", "hex": "#8a3b3b" },
      { "id": "blue", "label": "Blue", "hex": "#3a5a9a" },
      { "id": "teal", "label": "Teal blue", "hex": "#3d6b8f" },
      { "id": "purple", "label": "Purple", "hex": "#5b4a8a" },
      { "id": "white", "label": "White", "hex": "#e8e1d4" },
      { "id": "black", "label": "Black", "hex": "#1f1f24" }
    ],
    "bg": [
      { "id": "slate", "label": "Slate blue", "hex": "#2a3550" },
      { "id": "plum", "label": "Plum", "hex": "#3a2f4a" },
      { "id": "deepgreen", "label": "Deep green", "hex": "#22403a" },
      { "id": "brown", "label": "Brown", "hex": "#4a3424" },
      { "id": "grey", "label": "Grey", "hex": "#3d3d46" },
      { "id": "wine", "label": "Wine", "hex": "#4b2d33" }
    ],
    "frame": [
      { "id": "none", "label": "No frame" },
      { "id": "merit", "label": "Merit list", "ring": "#e09040", "badge": "10" },
      { "id": "duel", "label": "Duel winner", "ring": "#c3c9d4", "badge": "W" },
      { "id": "streak", "label": "30-day streak", "ring": "#e87b2e", "badge": "30" }
    ]
  },
  "inks": {
    "hair": "#17110e",
    "line": "#5a4438",
    "badgeText": "#0b0d11"
  },
  "frameStyle": {
    "$comment": "The ring sits outside the circle: a gap ring in the page colour, then the frame colour, each ringWidth wide. ringWidth is 3 at size 72 and up, else 2. The badge (bottom right, offset -3) only shows at size 56 and up; its height is max(14, round(size * 0.3)), its font round(height * 0.5), with a 2px page-colour outline.",
    "ringWidthLarge": 3,
    "ringWidthSmall": 2,
    "largeFrom": 72,
    "badgeFrom": 56,
    "badgeScale": 0.3,
    "badgeMin": 14,
    "badgeOffset": -3
  },
  "layers": [
    {
      "id": "afro",
      "when": { "hair": ["afro"], "head": ["none"] },
