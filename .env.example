# The base URL of your Railway-hosted backend (e.g., https://studybond-backend.up.railway.app)
BACKEND_API_BASE_URL=http://localhost:5000

# The URL of this web app in production (e.g., https://studybond.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the backend sends when an admin saves a premium price, so the
# public pages rebuild with the new price. Same value as WEB_REVALIDATE_SECRET
# on the backend (Railway). Unset = pages still refresh hourly.
REVALIDATE_SECRET=
